[package]
name = "fetch-codex-session-reader"
version = "0.1.0"
edition = "2024"

[dependencies]
anyhow = "1"
serde_json = "1"
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
codex-rollout = { path = "@SOURCE@/codex-rs/rollout" }
codex-thread-store = { path = "@SOURCE@/codex-rs/thread-store" }
codex-app-server-protocol = { path = "@SOURCE@/codex-rs/app-server-protocol" }
codex-protocol = { path = "@SOURCE@/codex-rs/protocol" }
codex-state = { path = "@SOURCE@/codex-rs/state" }
codex-utils-absolute-path = { path = "@SOURCE@/codex-rs/utils/absolute-path" }

[patch.crates-io]
tokio-tungstenite = { git = "https://github.com/openai-oss-forks/tokio-tungstenite", rev = "0e5b2d73aa18dd9f0a50ee9ff199d5aef7594186" }
tungstenite = { git = "https://github.com/openai-oss-forks/tungstenite-rs", rev = "4fffad30fe373adbdcffab9545e9e9bf4f2fc19f" }

[profile.dev]
debug = 0
incremental = false
